{
  "name": "flutter-pro-cli",
  "version": "1.0.0",
  "description": "CLI to install Flutter Pro Max skill for AI coding assistants",
  "type": "module",
  "bin": {
    "flutterpro": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun run src/index.ts",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "flutter",
    "dart",
    "flutter-rules",
    "flutter-skill",
    "claude",
    "cursor",
    "windsurf",
    "copilot",
    "kiro",
    "roocode",
    "codex",
    "ai",
    "skill"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.1",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.7.2"
  }
}
